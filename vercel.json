{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/pos", "destination": "https://pos.zameria.co/" },
    { "source": "/pos/:path*", "destination": "https://pos.zameria.co/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
